extends dashBase

block content
    div(class="mx-auto max-w-7xl")
        // Page Title and Action Button
        div(class="flex flex-wrap items-center justify-between gap-4 mb-6")
            h2(class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white") User Management
            button(id="addNewUserButton" class="flex h-10 cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-lg bg-primary px-4 text-sm font-bold text-white shadow-md hover:bg-primary/90")
                span(class="material-symbols-outlined text-base") add
                span(class="truncate") Add New User


        // Filters
        div(class="mb-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-background-dark/50 p-4")
            div(class="flex flex-col gap-4 lg:flex-row")
                div(class="relative flex-grow")
                    span(class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400") search
                    input(id="searchInput" class="form-input h-12 w-full rounded-lg border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-900 pl-11 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Search by name, email, or role..." type="text")
                div(class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:flex lg:flex-shrink-0 lg:items-center")
                    select(id="roleFilter" class="form-select h-12 w-full rounded-lg border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-900 text-gray-900 dark:text-white focus:border-primary focus:ring-primary lg:w-40")
                        option(value="All") All Roles
                        option(value="admin") Admin
                        option(value="user") User
                    select(id="accessFilter" class="form-select h-12 w-full rounded-lg border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-900 text-gray-900 dark:text-white focus:border-primary focus:ring-primary lg:w-48")
                        option(value="All") All Access
                        option(value="granted") Granted
                        option(value="banned") Banned
                        option(value="suspended") Suspended

        // User Table
        div(class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-background-dark/50")
            div(class="overflow-x-auto")
                table(class="min-w-full divide-y divide-gray-200 dark:divide-gray-800")
                    thead(class="bg-gray-50 dark:bg-background-dark/30")
                        tr
                            th(class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-white sm:pl-6" scope="col") User
                            th(class="py-3.5 px-3 text-left text-sm font-semibold text-gray-900 dark:text-white" scope="col") Role
                            th(class="py-3.5 px-3 text-left text-sm font-semibold text-gray-900 dark:text-white" scope="col") Status
                            th(class="py-3.5 px-3 text-left text-sm font-semibold text-gray-900 dark:text-white" scope="col") Access Status
                            th(class="relative py-3.5 pl-3 pr-4 sm:pr-6" scope="col")
                                span(class="sr-only") Actions
                    tbody(id="userTableBody" class="divide-y divide-gray-200 dark:divide-gray-800")
                        // JS will insert rows here

            // Pagination
            div(class="flex items-center justify-between border-t border-gray-200 dark:border-gray-800 px-4 py-3 sm:px-6")
                // Mobile Pagination
                div(class="flex flex-1 justify-between sm:hidden" id="mobilePagination")
                    button(data-action="prev" class="relative inline-flex items-center rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 disabled:opacity-50") Previous
                    button(data-action="next" class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 disabled:opacity-50") Next

                // Desktop Pagination
                div(class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between")
                    div
                        p(class="text-sm text-gray-700 dark:text-gray-400")
                            | Showing 
                            span(id="summaryStart" class="font-medium") 0
                            |  to 
                            span(id="summaryEnd" class="font-medium") 0
                            |  of 
                            span(id="summaryTotal" class="font-medium") 0
                            |  results
                    div
                        nav(id="paginationContainer" class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination")
                            // Pagination links will be injected here
    #newUserModal(class="hidden fixed inset-0 z-50 overflow-y-auto")
        .flex(class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0")
            // Modal Overlay
            #modalOverlay(class="fixed inset-0 transition-opacity", aria-hidden="true")
                .absolute(class="absolute inset-0 bg-gray-500 dark:bg-gray-900 opacity-75")

            // Modal Content
            span(class="hidden sm:inline-block sm:align-middle sm:h-screen", aria-hidden="true") &#8203;
            .modalContent(class="inline-block align-bottom bg-white dark:bg-background-dark rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full")
                form#newUserForm
                    .modalBody(class="bg-white dark:bg-background-dark px-4 pt-5 pb-4 sm:p-6 sm:pb-4")
                        .modalFlex(class="sm:flex sm:items-start")
                            .modalIcon(class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-primary/10 sm:mx-0 sm:h-10 sm:w-10")
                                span(class="material-symbols-outlined text-primary") person_add
                            .modalText(class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full")
                                h3#modal-title(class="text-lg leading-6 font-medium text-gray-900 dark:text-white") Add New User
                                .formFields(class="mt-4 space-y-4")
                                    div
                                        label(class="block text-sm font-medium text-gray-700 dark:text-gray-300", for="newUserName") Full Name
                                        input#newUserName(class="form-input mt-1 block w-full rounded-lg border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-900 text-gray-900 dark:text-white focus:border-primary focus:ring-primary", type="text", name="newUserName", required)
                                    div
                                        label(class="block text-sm font-medium text-gray-700 dark:text-gray-300", for="newUserEmail") Email Address
                                        input#newUserEmail(class="form-input mt-1 block w-full rounded-lg border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-900 text-gray-900 dark:text-white focus:border-primary focus:ring-primary", type="email", name="newUserEmail", required)
                                    .formGrid(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                                        div
                                            label(class="block text-sm font-medium text-gray-700 dark:text-gray-300", for="newUserRole") Role
                                            select#newUserRole(class="form-select mt-1 block w-full rounded-lg border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-900 text-gray-900 dark:text-white focus:border-primary focus:ring-primary", name="newUserRole")
                                                option Officer
                                                option Analyst
                                                option Admin
                                        div
                                            label(class="block text-sm font-medium text-gray-700 dark:text-gray-300", for="newUserAccess") Access Status
                                            select#newUserAccess(class="form-select mt-1 block w-full rounded-lg border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-900 text-gray-900 dark:text-white focus:border-primary focus:ring-primary", name="newUserAccess")
                                                option Granted
                                                option Suspended
                                                option Banned
                    .modalFooter(class="bg-gray-50 dark:bg-background-dark/50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse")
                        button(type="submit", class="w-full inline-flex justify-center rounded-lg border border-transparent shadow-sm px-4 py-2 bg-primary text-base font-medium text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary sm:ml-3 sm:w-auto sm:text-sm") Save User
                        button#closeModalButton(type="button", class="mt-3 w-full inline-flex justify-center rounded-lg border border-gray-300 dark:border-gray-700 shadow-sm px-4 py-2 bg-white dark:bg-gray-800 text-base font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary sm:mt-0 sm:w-auto sm:text-sm") Cancel

        include user_js.pug
