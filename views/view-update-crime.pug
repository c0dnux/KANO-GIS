extends dashBase 


block content 
    main(class="flex-1 p-4 sm:p-8")
        div(class="max-w-4xl mx-auto")
            div(class="flex items-center mb-6 text-sm text-subtle-light dark:text-subtle-dark")
                a(class="hover:underline text-primary" href="#") Reports
                span(class="mx-2") /
                span Edit Report

            div(class="mb-8")
                h2(class="text-3xl font-bold text-foreground-light dark:text-foreground-dark") Report #20240726-001
                p(class="text-subtle-light dark:text-subtle-dark mt-1") Submitted on July 26, 2024, 10:30 AM

            // Report Form
            form(id="report-form" class="bg-background-light dark:bg-background-dark border border-border-light dark:border-border-dark rounded-lg p-6")
                h3(class="text-xl font-bold mb-6 text-foreground-light dark:text-foreground-dark") Edit Incident Details
                div(class="grid grid-cols-1 md:grid-cols-2 gap-6")

                    // Type of Crime (Display Only)
                    div
                        label(for="crime-type" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Type of Crime
                        input(type="text" id="crime-type" name="crime_type" value="Theft" disabled class="form-input w-full rounded border-border-light dark:border-border-dark bg-gray-100 dark:bg-gray-800 text-subtle-light dark:text-subtle-dark cursor-not-allowed")

                    // City
                    div
                        label(for="city" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") City
                        input(type="text" id="city" name="city" value="Kano" class="form-input w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary")

                    // Local Government
                    div
                        label(for="local-government" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Local Government
                        input(type="text" id="local-government" name="local_government" value="Fagge" class="form-input w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary")

                    // Address
                    div
                        label(for="address" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Address
                        input(type="text" id="address" name="address" value="Near the market" class="form-input w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary")

                    // Date and Time
                    div
                        label(for="datetime" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Date & Time
                        input(type="datetime-local" id="datetime" name="datetime" value="2024-07-25T20:00" class="form-input w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary")

                    // Number of Victims
                    div
                        label(for="victims" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Number of Victims
                        input(type="number" id="victims" name="victims" value="1" min="0" class="form-input w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary")

                    // Description
                    div(class="md:col-span-2")
                        label(for="description" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Description
                        textarea(id="description" name="description" rows="4" class="form-textarea w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary") A mobile phone was stolen from a person near the market.

                    // Report Status
                    div
                        label(for="report-status" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Report Status
                        select(id="report-status" name="status" class="form-select w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary")
                            option New
                            option(selected) Under Investigation
                            option Resolved
                            option Closed

                    // Report Authenticity
                    div
                        label(for="report-authenticity" class="block text-sm font-medium text-foreground-light dark:text-foreground-dark mb-2") Report Authenticity
                        select(id="report-authenticity" name="authenticity" class="form-select w-full rounded border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark text-foreground-light dark:text-foreground-dark focus:ring-primary focus:border-primary")
                            option(selected) Unverified
                            option Verified
                            option Fake

                // Actions
                div(class="mt-8 flex justify-end gap-4")
                    button(type="button" class="bg-gray-200 dark:bg-gray-700 text-foreground-light dark:text-foreground-dark font-bold py-2 px-4 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors") Cancel
                    button(type="submit" class="bg-primary text-white font-bold py-2 px-4 rounded hover:bg-primary/90 transition-colors") Update Report


