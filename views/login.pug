extends authBase

block content
    div(class="w-full max-w-md space-y-8 bg-white dark:bg-background-dark/50 p-8 sm:p-10 rounded-xl shadow-lg dark:shadow-2xl")
        div
            h2(class="text-center text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100") Welcome Back
            p(class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400")
                | Sign in to access the Crime GIS System

        form#login-form(class="space-y-6" action="#" method="POST")
            div(class="space-y-2")
                label(for="username" class="text-sm font-medium text-gray-700 dark:text-gray-300") Username or Email
                input#username.form-input(
                    type="text"
                    name="username"
                    autocomplete="username"
                    placeholder="Enter your username or email"
                    required
                    class="w-full px-4 py-3 bg-background-light dark:bg-background-dark border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-primary focus:border-primary text-gray-900 dark:text-gray-100"
                )

            // 🔹 Password Field
            div(class="space-y-2 relative")
                label(for="password" class="text-sm font-medium text-gray-700 dark:text-gray-300") Password
                div(class="relative")
                    input#password.form-input(
                        type="password"
                        name="password"
                        autocomplete="current-password"
                        placeholder="Enter your password"
                        required
                        class="w-full px-4 py-3 bg-background-light dark:bg-background-dark border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-primary focus:border-primary text-gray-900 dark:text-gray-100 pr-10"
                    )

                    // 👁️ Password toggle button
                    button.password-toggle-btn(
                        type="button"
                        data-input-id="password"
                        class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 focus:outline-none"
                    )
                        svg.eye-open-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M2.25 12s3.75-7.5 9.75-7.5S21.75 12 21.75 12s-3.75 7.5-9.75 7.5S2.25 12 2.25 12z")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                        svg.eye-closed-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 hidden")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.45 10.45 0 002.25 12s3.75 7.5 9.75 7.5c1.31 0 2.57-.21 3.74-.6M9.88 9.88A3 3 0 0114.12 14.12M9.88 9.88L3 3m6.88 6.88L21 21")

            div(class="flex items-center justify-end")
                div(class="text-sm")
                    a#forgot-password(class="font-medium text-primary hover:text-primary/80" ) Forgot password?

            div
                button( id="login-btn"
                    type="submit"
                    class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary focus:ring-offset-background-light dark:focus:ring-offset-background-dark"
                ) Log In

        p(class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400")
            | Don't have an account? 
            a(class="font-medium text-primary hover:text-primary/80" href="/signup") Sign Up
