doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Crime Repo - Kano State Crime GIS
    script(src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
    link(rel="icon" type="image/png" href="/favicon.png")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;700;900&display=swap", rel="stylesheet")
    script(src="/js/tailwindjs.js") 
    script(type="module" src="/js/index.js")
    style.
      .material-symbols-outlined {
        font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
      }

  body(class="bg-background-light dark:bg-background-dark font-display text-slate-800 dark:text-slate-200")
    .flex.flex-col.min-h-screen
      header(class="sticky top-0 z-50 bg-background-light dark:bg-background-dark border-b border-slate-200 dark:border-slate-800")
        nav.container.mx-auto.px-6.py-4.flex.justify-between.items-center
          .flex.items-center.gap-3
            span(class="material-symbols-outlined text-primary text-3xl") local_police
            h1(class="text-2xl font-bold text-slate-900 dark:text-white") Crime Repo
          .flex.items-center.gap-4
            if user
              a(href="/dashboard" class="text-slate-600 dark:text-slate-300 hover:text-primary dark:hover:text-primary transition-colors font-medium") 
                img(src=`/policeman.png`, alt=user.name, class="w-10 h-10 rounded-full object-cover")
            else
              a(class="text-slate-600 dark:text-slate-300 hover:text-primary dark:hover:text-primary transition-colors font-medium", href="/login") Login
              a(class="bg-primary text-white px-4 py-2 rounded-lg font-bold hover:bg-opacity-90 transition-colors", href="/signup") Sign Up

      main.flex-grow
        section(class="relative bg-cover bg-center h-[600px] flex items-center", style="background-image: linear-gradient(rgba(16, 25, 34, 0.7), rgba(16, 25, 34, 0.7)), url('/crime.jpg');")
          .container.mx-auto.px-6.text-center.text-white
            h2(class="text-4xl md:text-6xl font-black leading-tight tracking-tight")
              | Welcome to Crime Repo
            p.mt-4.max-w-2xl.mx-auto.text-lg.text-slate-200
              | The premier GIS-based crime analysis and reporting system for Kano State. Track, analyze, and combat crime with cutting-edge technology.
            .mt-8.flex.gap-4.justify-center
              if user
                a(class="bg-primary text-white px-6 py-3 rounded-lg text-lg font-bold hover:bg-opacity-90 transition-transform transform hover:scale-105", href="/report-crime") Report Crime
              else
                a(class="bg-primary text-white px-6 py-3 rounded-lg text-lg font-bold hover:bg-opacity-90 transition-transform transform hover:scale-105", href="/login") Report Crime
              a(class="bg-white/10 text-white px-6 py-3 rounded-lg text-lg font-bold hover:bg-white/20 transition-colors", href="/map") Check Map

        section(class="py-16 md:py-24 bg-white dark:bg-slate-900/50")
          .container.mx-auto.px-6
            .text-center.mb-12
              h3(class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white")
                | Crime Rundown
              p(class="mt-4 text-lg text-slate-600 dark:text-slate-400 max-w-3xl mx-auto")
                | A comprehensive, real-time overview of the crime statistics and insights in Kano State.
            div(class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-7xl mx-auto")
              .flex.flex-col.gap-8
                div(class="bg-background-light dark:bg-slate-800 p-8 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center gap-6 shadow-md")
                  div(class="flex-shrink-0 w-16 h-16 flex items-center justify-center rounded-full bg-primary/10 text-primary")
                    svg(xmlns="http://www.w3.org/2000/svg", width="32", height="32", fill="currentColor", viewBox="0 0 256 256")
                      path(d="M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Z")
                  div
                    h4(class="text-xl font-bold text-slate-800 dark:text-white") Total Reports Filed
                    p.text-5xl.font-black.text-primary.mt-1=totalCrimes
                div(class="bg-background-light dark:bg-slate-800 p-8 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center gap-6 shadow-md")
                  div(class="flex-shrink-0 w-16 h-16 flex items-center justify-center rounded-full bg-red-500/10 text-red-500")
                    svg(xmlns="http://www.w3.org/2000/svg", width="32", height="32", fill="currentColor", viewBox="0 0 256 256")
                      path(d="M244.8,150.4a8,8,0,0,1-11.2-1.6A51.6,51.6,0,0,0,192,128a8,8,0,0,1-7.37-4.89,40,40,0,1,0-113.26,0A8,8,0,0,1,64,128a51.6,51.6,0,0,0-41.6,20.8,8,8,0,1,1-12.8-9.6A67.81,67.81,0,0,1,64,112a8,8,0,0,1,8-8,56,56,0,1,1,112,0,8,8,0,0,1,8,8,67.81,67.81,0,0,1,54.4,27.2A8,8,0,0,1,244.8,150.4Z")
                  div
                    h4(class="text-xl font-bold text-slate-800 dark:text-white") Total Victims Affected
                    p.text-5xl.font-black.text-red-500.mt-1=totalVictims
              .flex.flex-col.gap-8
                div(class="bg-background-light dark:bg-slate-800 p-8 rounded-xl border border-slate-200 dark:border-slate-700 shadow-md")
                  h4(class="text-xl font-bold text-slate-900 dark:text-white mb-4") Breakdown by Type
                  .space-y-4
                    if updatedBreakdown.length === 0
                      p(class="text-slate-600 dark:text-slate-300") No crime data available.
                    each crime in updatedBreakdown
                      div
                        div(class="flex justify-between mb-1 text-sm font-medium text-slate-600 dark:text-slate-300")
                          span=crime._id
                          span=crime.count
                        div(class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2.5")
                          div(class=`${crime.color} h-2.5 rounded-full`, style=`width: ${crime.percentage}%`)
                div(class="bg-background-light dark:bg-slate-800 p-8 rounded-xl border border-slate-200 dark:border-slate-700 shadow-md")
                  h4(class="text-xl font-bold text-slate-900 dark:text-white mb-4") Report Status Overview
                  .space-y-4
                    if updatedOverview.length === 0
                      p(class="text-slate-600 dark:text-slate-300") No status data available.
                    each status in updatedOverview
                      div
                        div(class="flex justify-between mb-1 text-sm font-medium text-slate-600 dark:text-slate-300")
                          span=status._id
                          span=status.count
                        div(class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2.5")
                          div(class=`${status.color} h-2.5 rounded-full`, style=`width: ${status.percentage}%`)

        section#features(class="py-16 md:py-24 bg-background-light dark:bg-background-dark")
          .container.mx-auto.px-6
            .text-center.mb-12
              h3(class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white")
                | Key Features
              p(class="mt-4 text-lg text-slate-600 dark:text-slate-400 max-w-3xl mx-auto")
                | Crime Repo offers a range of powerful tools to help you understand and address crime in Kano State.
            div(class="grid md:grid-cols-3 gap-8")
              div(class="bg-white dark:bg-slate-800/50 p-8 rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col items-center text-center shadow-sm hover:shadow-lg transition-shadow")
                div(class="bg-primary/10 dark:bg-primary/20 text-primary p-4 rounded-full mb-6")
                  svg(fill="currentColor", height="32", viewBox="0 0 256 256", width="32", xmlns="http://www.w3.org/2000/svg")
                    path(d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z")
                h4(class="text-xl font-bold mb-2 text-slate-900 dark:text-white")
                  | Interactive Mapping
                p(class="text-slate-600 dark:text-slate-400")
                  | Visualize crime hotspots and patterns on an interactive map.
              div(class="bg-white dark:bg-slate-800/50 p-8 rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col items-center text-center shadow-sm hover:shadow-lg transition-shadow")
                div(class="bg-primary/10 dark:bg-primary/20 text-primary p-4 rounded-full mb-6")
                  svg(fill="currentColor", height="32", viewBox="0 0 256 256", width="32", xmlns="http://www.w3.org/2000/svg")
                    path(d="M232,208a8,8,0,0,1-8,8H32a8,8,0,0,1-8-8V48a8,8,0,0,1,16,0v94.37L90.73,98a8,8,0,0,1,10.07-.38l58.81,44.11L218.73,90a8,8,0,1,1,10.54,12l-64,56a8,8,0,0,1-10.07.38L96.39,114.29,40,163.63V200H224A8,8,0,0,1,232,208Z")
                h4(class="text-xl font-bold mb-2 text-slate-900 dark:text-white")
                  | Data Analysis
                p(class="text-slate-600 dark:text-slate-400")
                  | Analyze crime trends over time with detailed reports and charts.
              div(class="bg-white dark:bg-slate-800/50 p-8 rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col items-center text-center shadow-sm hover:shadow-lg transition-shadow")
                div(class="bg-primary/10 dark:bg-primary/20 text-primary p-4 rounded-full mb-6")
                  svg(fill="currentColor", height="32", viewBox="0 0 256 256", width="32", xmlns="http://www.w3.org/2000/svg")
                    path(d="M208,40H48A16,16,0,0,0,32,56v58.78c0,89.61,75.82,119.34,91,124.39a15.53,15.53,0,0,0,10,0c15.2-5.05,91-34.78,91-124.39V56A16,16,0,0,0,208,40Zm0,74.79c0,78.42-66.35,104.62-80,109.18-13.53-4.51-80-30.69-80-109.18V56H208ZM82.34,141.66a8,8,0,0,1,11.32-11.32L112,148.68l50.34-50.34a8,8,0,0,1,11.32,11.32l-56,56a8,8,0,0,1-11.32,0Z")
                h4(class="text-xl font-bold mb-2 text-slate-900 dark:text-white")
                  | Security Insights
                p(class="text-slate-600 dark:text-slate-400")
                  | Gain valuable insights to improve community safety and security strategies.
              div(class="bg-white dark:bg-slate-800/50 p-8 rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col items-center text-center shadow-sm hover:shadow-lg transition-shadow")
                div(class="bg-primary/10 dark:bg-primary/20 text-primary p-4 rounded-full mb-6")
                  span(class="material-symbols-outlined text-3xl") api
                h4(class="text-xl font-bold mb-2 text-slate-900 dark:text-white") Free API Requests
                p(class="text-slate-600 dark:text-slate-400")
                  | Everyone gets 100 free requests daily to our public crime data API.
                button(id="btn-copy-api" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-gray-300 bg-white text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 transition-all")
                  span(class="material-symbols-outlined text-[20px]") link
                  span(id="btn-copy-text") Copy API

        section#contact(class="py-16 md:py-24 bg-white dark:bg-slate-900")
          .container.mx-auto.px-6
            .text-center.mb-12
              h3(class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white")
                | Contact Us
              p(class="mt-4 text-lg text-slate-600 dark:text-slate-400 max-w-3xl mx-auto")
                | Have a question or need support? Fill out the form below and we'll get back to you as soon as possible.
            .max-w-2xl.mx-auto
              form.space-y-6(id="contact-form")
                div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
                  div
                    label(class="block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-2" for="name") Full Name
                    input#name(class="w-full bg-background-light dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg focus:ring-primary focus:border-primary", type="text", name="name", placeholder="Enter your full name")
                  div
                    label(class="block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-2" for="email") Email Address
                    input#email(class="w-full bg-background-light dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg focus:ring-primary focus:border-primary", type="email", name="email", placeholder="Enter your email address")
                div
                  label(class="block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-2" for="subject") Subject
                  input#subject(class="w-full bg-background-light dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg focus:ring-primary focus:border-primary", type="text", name="subject", placeholder="What is your message about?")
                div
                  label(class="block.text-sm.font-medium.text-slate-700.dark:text-slate-300.mb-2" for="message") Message
                  textarea#message(class="w-full bg-background-light dark:bg-slate-800 border-slate-300 dark:border-slate-700 rounded-lg focus:ring-primary focus:border-primary", name="message", rows="4", placeholder="Write your message here...")
                .text-center
                  button(class="bg-primary text-white px-8 py-3 rounded-lg text-lg font-bold hover:bg-opacity-90 transition-colors", type="submit")
                    | Send Message

      footer(class="bg-background-light dark:bg-background-dark border-t border-slate-200 dark:border-slate-800")
        div(class="container mx-auto px-6 py-6 text-center text-slate-500 dark:text-slate-400")
          p © 2025 Crime Repo. All rights reserved.

    script.
      // Check if the user's system preference is set to dark
      if (
        window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: dark)").matches
      ) {
        // If it is, add the 'dark' class to the <html> element
        document.documentElement.classList.add("dark");
      }

      const contactForm = document.getElementById('contact-form');
      if (contactForm) {
        contactForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = contactForm.querySelector('button[type="submit"]');
          const originalText = btn.textContent;
          btn.disabled = true;
          btn.textContent = 'Sending...';

          const data = {
            name: contactForm.name.value,
            email: contactForm.email.value,
            subject: contactForm.subject.value,
            message: contactForm.message.value,
          };

          try {
            const res = await fetch('/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            const result = await res.json();
            alert(result.message);
            if (result.status === 'Success') contactForm.reset();
          } catch (err) {
            alert('Failed to send message. Please try again.');
          } finally {
            btn.disabled = false;
            btn.textContent = originalText;
          }
        });
      }