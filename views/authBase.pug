html(lang="en")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title=title
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;700&display=swap")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined")
        link(rel="icon" type="image/png" href="/favicon.png")
        script(src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
        script(src="/js/tailwindjs.js")
        if page && page==="login"
            script(src="/js/togglelogin.js")
        else 
            script(src="/js/password-toggle.js")
    body(class="bg-background-light dark:bg-background-dark font-display")
        div(class="flex flex-col min-h-screen")
            header(class="w-full")
                div(class="container mx-auto px-4 sm:px-6 lg:px-8")
                    div(class="flex items-center justify-between py-6")
                        a(class="flex items-center gap-2" href="/")
                            span(class="material-symbols-outlined text-primary text-2xl") local_police
                            h1(class="text-xl font-bold text-gray-900 dark:text-gray-100 hover:text-primary transition-colors") Crime Repo

            main(class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8")
                block content
        script(type="module" src="/js/index.js")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" integrity="sha512-h9644v03pHqrIHThkvXhB2PJ8zf5E9IyVnrSfZg8Yj8k4RsO4zldcQc4Bi9iVLUCCsqNY0b4WXVV4UB+wbWENA==" crossorigin="anonymous" referrerpolicy="no-referrer")
