extends authBase

block content
    div(class="w-full max-w-md space-y-8")
        div
            h2(class="mt-6 text-center text-3xl font-bold tracking-tight text-slate-900 dark:text-white") Create your account
            p(class="mt-2 text-center text-sm text-slate-600 dark:text-slate-400") Join the platform to help make Kano safer.
        form#signup-form( class="mt-8 space-y-6")
            div(class="rounded-lg shadow-sm -space-y-px")
                div(class="relative")
                    label(class="sr-only" for="full-name") Full Name
                    input#name(class="relative block w-full appearance-none rounded-t-lg border border-slate-300 dark:border-slate-700 bg-background-light dark:bg-background-dark px-3 py-3 text-slate-900 dark:text-white placeholder-slate-500 dark:placeholder-slate-400 focus:z-10 focus:border-primary focus:outline-none focus:ring-primary sm:text-sm" type="text" name="name" placeholder="Full Name" required)
                div(class="relative")
                    label(class="sr-only" for="email-address") Email address
                    input#email(class="relative block w-full appearance-none border border-slate-300 dark:border-slate-700 bg-background-light dark:bg-background-dark px-3 py-3 text-slate-900 dark:text-white placeholder-slate-500 dark:placeholder-slate-400 focus:z-10 focus:border-primary focus:outline-none focus:ring-primary sm:text-sm" type="email" name="email" placeholder="Email address" required)

                // --- Password Field (Updated) ---
                div(class="relative")
                    label(class="sr-only" for="password") Password
                    // Added pr-10 for padding on the right to make space for the icon
                    input#password(class="relative block w-full appearance-none border border-slate-300 dark:border-slate-700 bg-background-light dark:bg-background-dark px-3 py-3 pr-10 text-slate-900 dark:text-white placeholder-slate-500 dark:placeholder-slate-400 focus:z-10 focus:border-primary focus:outline-none focus:ring-primary sm:text-sm" type="password" name="password" placeholder="Password" required)
                    // Toggle Button
                    button(type="button" id="toggle-password-btn" class="absolute inset-y-0 right-0 z-10 flex items-center pr-3 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300")
                        // Eye Icon (Visible by default)
                        svg(class="h-5 w-5" id="eye-open-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                        // Eye-Slash Icon (Hidden by default)
                        svg(class="h-5 w-5 hidden" id="eye-closed-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.243 4.243L12 12")

                // --- Confirm Password Field (Updated) ---
                div(class="relative")
                    label(class="sr-only" for="confirm-password") Confirm Password
                    // Added pr-10 for padding
                    input#confirmPassword(class="relative block w-full appearance-none rounded-b-lg border border-slate-300 dark:border-slate-700 bg-background-light dark:bg-background-dark px-3 py-3 pr-10 text-slate-900 dark:text-white placeholder-slate-500 dark:placeholder-slate-400 focus:z-10 focus:border-primary focus:outline-none focus:ring-primary sm:text-sm" type="password" name="confirm-password" placeholder="Confirm Password" required)
                    // Toggle Button (with unique IDs)
                    button(type="button" id="toggle-confirm-password-btn" class="absolute inset-y-0 right-0 z-10 flex items-center pr-3 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300")
                        // Eye Icon (Visible by default)
                        svg(class="h-5 w-5" id="confirm-eye-open-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                        // Eye-Slash Icon (Hidden by default)
                        svg(class="h-5 w-5 hidden" id="confirm-eye-closed-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.243 4.243L12 12")

            div
                button(id="signup-btn" type="submit" class="group relative flex w-full justify-center rounded-lg border border-transparent bg-primary py-3 px-4 text-sm font-medium text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background-light dark:focus:ring-offset-background-dark") Sign Up
        p(class="mt-4 text-center text-sm text-slate-600 dark:text-slate-400") 
            | Already have an account? 
            a(class="font-medium text-primary hover:text-primary/90" href="/login") Sign in   