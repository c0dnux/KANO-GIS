doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Password Reset Request
    body(style="margin:0;padding:0;background-color:#f4f4f5;font-family:'Inter',sans-serif;color:#1f2937;")
        div(style='max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:12px;box-shadow:0 6px 16px rgba(0,0,0,0.1);overflow:hidden;')

            // Header Section
            div(style='background-color:#3b82f6;padding:24px;text-align:center;color:#ffffff;')
                h1(style='margin:0;font-size:24px;font-weight:700;') Password Reset Request

            // Main Content Section
            div(style='padding:24px 32px;color:#374151;')
                p(style='font-size:18px;margin:0 0 16px 0;')
                    | Hi 
                    strong(style='font-weight:600;color:#111827;') #{firstName}
                    | ,
                p(style='font-size:16px;line-height:1.6;margin:0 0 16px 0;')
                    | We received a request to reset the password for your account. Please click the button below to choose a new one.
                p(style='font-size:16px;line-height:1.6;margin:0 0 24px 0;')
                    | This link is only valid for the next 10 minutes.

                // CTA Button
                table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style='margin-bottom:24px;')
                    tr
                        td(align="center")
                            table(role="presentation" border="0" cellpadding="0" cellspacing="0")
                                tr
                                    td(style='background-color:#3b82f6;border-radius:8px;text-align:center;')
                                        a(href=`${url}` target="_blank" style='display:inline-block;text-decoration:none;color:#ffffff;padding:12px 24px;font-size:16px;font-weight:700;border-radius:8px;') Reset Your Password

                p(style='font-size:16px;line-height:1.6;margin:0 0 16px 0;')
                    | If you did not request a password reset, you can safely ignore this email. Your account is secure.
                p(style='font-size:16px;line-height:1.6;margin:0;')
                    | - The Crime Repo Team

            // Footer Section
            div(style='background-color:#f3f4f6;border-top:1px solid #e5e7eb;text-align:center;padding:24px;color:#6b7280;')
                p(style='margin:0;font-size:14px;line-height:1.6;')
                    | © 2026 Crime Repo. All Rights Reserved.
                    br
                    | No 225 Sharada Phase 1, Kano, Nigeria.
